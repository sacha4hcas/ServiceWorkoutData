<name>sys_script_include_6631261bc3418f90635598fdd4013172</name>
<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update table="sys_script_include"&gt;&lt;sys_script_include action="INSERT_OR_UPDATE"&gt;&lt;access&gt;public&lt;/access&gt;&lt;active&gt;true&lt;/active&gt;&lt;api_name&gt;global.LoadDataToApp&lt;/api_name&gt;&lt;caller_access/&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;description/&gt;&lt;mobile_callable&gt;false&lt;/mobile_callable&gt;&lt;name&gt;LoadDataToApp&lt;/name&gt;&lt;sandbox_callable&gt;false&lt;/sandbox_callable&gt;&lt;script&gt;&lt;![CDATA[var LoadDataToApp = Class.create();
LoadDataToApp.getAppId = function(scope) {
    var grApp = new GlideRecord("sys_app");
	if(grApp.get("scope", scope))
		return grApp.getUniqueValue();
	else return "";
};
LoadDataToApp.getDataTables = function(sourceScope) {
    //get all data tables of sourceScope App
	var grTable = new GlideRecord("sys_db_object");
	grTable.addQuery("sys_scope", LoadDataToApp.getAppId(sourceScope));
	//exclude import set table
	grTable.addQuery("super_class!=099be20a183232108bb255f46a373a61^ORsuper_class=NULL");
	//exclude application files
	grTable.addQuery("super_class!=c21b2202183232108bb255f46a373aa2^ORsuper_class=NULL");

	var dataTables = [];

	grTable.query();
	while(grTable.next()){
		dataTables.push(grTable.name.toString());
	}
	return dataTables;
};
LoadDataToApp.loadData = function(sourceScope, targetScope){
	targetScope = targetScope || sourceScope;
	//backup all data tables
	var returnData = {};
	LoadDataToApp.getDataTables(sourceScope).forEach(function(tableName){
		returnData[tableName] = new LoadDataToApp(tableName, targetScope).begin();
	});
	return returnData;
};

LoadDataToApp.prototype = {
    initialize: function(table_name, targetScope) {
        this.table_name = table_name;
        this.applicationId = LoadDataToApp.getAppId(targetScope);
    },



    begin: function() {
        var gr = new GlideRecord(this.table_name);

        if (this.sys_id_list) {
            var selectedRecords = this.sys_id_list.split(',');
            gr.addQuery('sys_id', selectedRecords);
        }
        if (this.query) {
            gr.addQuery(this.query);
        }
        gr.query();

        var recCntr = 0;
        var invRecCntr = 0;
		var alreadyExistsCount = 0;
        while (gr.next()) {
            if (!this.metadataAlreadyExists(gr)) {
                this.addMetadata(gr);
                recCntr++;
            } else {
				alreadyExistsCount++
                if (this.overwriteMetadata(gr))
                    invRecCntr++;
            }
        }
		gs.info("Already exists : " + alreadyExistsCount);
        return {
            "created": recCntr,
            "updated": invRecCntr
        };
    },

    metadataAlreadyExists: function(gr) {
        var output = new GlideRecord('sys_metadata_link');
		output.addQuery("documentkey", gr.sys_id);
		output.addQuery("sys_scope", this.applicationId);
		output.addQuery("directory", "update");
		output.addQuery("tablename", this.table_name);
        output.query();
		return output.next();
    },

    addMetadata: function(linkedRecord) {
        var payloadStr = gs.unloadRecordToXML(linkedRecord, true);
        var output = new GlideRecord('sys_metadata_link');
        output.query();
        output.initialize();
		output.sys_scope = this.applicationId;
        output.payload = payloadStr;
        output.documentkey = linkedRecord.sys_id;
        output.tablename = this.table_name;
        output.sys_name = linkedRecord.getDisplayValue();
        output.directory = "update";
        output.insert();
    },

    overwriteMetadata: function(linkedRecord) {
        var payloadStr = gs.unloadRecordToXML(linkedRecord, true);
        var output = new GlideRecord('sys_metadata_link');
        output.addQuery('documentkey', linkedRecord.sys_id);
        output.addQuery('sys_scope', this.applicationId);
        output.addQuery('tablename', this.table_name);
        output.addQuery('directory', "update");
        output.query();

        if (output.next()) {
            output.payload = payloadStr;
            output.sys_name = linkedRecord.getDisplayValue();
            return output.update();
        }

        return null;
    },

    type: 'LoadDataToApp'
};]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script_include&lt;/sys_class_name&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-05-29 20:19:45&lt;/sys_created_on&gt;&lt;sys_id&gt;6631261bc3418f90635598fdd4013172&lt;/sys_id&gt;&lt;sys_mod_count&gt;11&lt;/sys_mod_count&gt;&lt;sys_name&gt;LoadDataToApp&lt;/sys_name&gt;&lt;sys_package display_value="Global" source="global"&gt;global&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Global"&gt;global&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_include_6631261bc3418f90635598fdd4013172&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-05-29 20:54:59&lt;/sys_updated_on&gt;&lt;/sys_script_include&gt;&lt;sys_es_latest_script action="INSERT_OR_UPDATE"&gt;&lt;id&gt;6631261bc3418f90635598fdd4013172&lt;/id&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-05-29 20:19:45&lt;/sys_created_on&gt;&lt;sys_id&gt;22312e1bc3418f90635598fdd401313f&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-05-29 20:19:45&lt;/sys_updated_on&gt;&lt;table&gt;sys_script_include&lt;/table&gt;&lt;use_es_latest&gt;true&lt;/use_es_latest&gt;&lt;/sys_es_latest_script&gt;&lt;/record_update&gt;</payload>
